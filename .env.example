GROQ_API_KEY=

# https://openrouter.ai        - diversity, eval judges (judge != judged)
OPENROUTER_API_KEY=

# Day 73. Free LangSmith developer tier. Optional.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
